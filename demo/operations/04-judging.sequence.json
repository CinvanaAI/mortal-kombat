      "label": "Decision log"
    }
  ],
  "messages": [
    {
      "id": "rr-04-judging-1",
      "from": "rr-judging-core",
      "to": "rr-judging-judge",
      "label": "Candidate A and incumbent B views",
      "y": 160
    },
    {
      "id": "rr-04-judging-2",
      "from": "rr-judging-judge",
      "to": "rr-judging-rules",
      "label": "Rules path: aggregate case-sensitive matches",
      "y": 189
    },
    {
      "id": "rr-04-judging-3",
      "from": "rr-judging-rules",
      "to": "rr-judging-judge",
      "label": "Greater score wins; equal score uses ID order",
      "y": 218,
      "variant": "return"
    },
    {
      "id": "rr-04-judging-4",
      "from": "rr-judging-judge",
      "to": "rr-judging-bundle",
      "label": "Provider path: task + rubric + all artifacts",
      "y": 247
    },
    {
      "id": "rr-04-judging-5",
      "from": "rr-judging-bundle",
      "to": "rr-judging-provider",
      "label": "Source text and both outputs for every example",
      "y": 276
    },
    {
      "id": "rr-04-judging-6",
      "from": "rr-judging-provider",
      "to": "rr-judging-judge",
      "label": "Returned text, usage and completion state",
      "y": 305,
      "variant": "return"
    },
    {
      "id": "rr-04-judging-7",
      "from": "rr-judging-judge",
      "to": "rr-judging-contract",
      "label": "Require supported winner + nonempty reason",
      "y": 334,
      "variant": "security"
    },
    {
      "id": "rr-04-judging-8",
      "from": "rr-judging-contract",
      "to": "rr-judging-judge",
      "label": "Accept only null / finite numeric 0..1 confidence",
      "y": 363,
      "variant": "return"
    },
    {
      "id": "rr-04-judging-9",
      "from": "rr-judging-judge",
      "to": "rr-judging-ledger",
      "label": "Append valid A/B decision and explanation",
      "y": 392
    },
    {
      "id": "rr-04-judging-10",
      "from": "rr-judging-judge",
      "to": "rr-judging-core",
      "label": "Return decision; core applies it to insertion",
      "y": 421,
      "variant": "return"
    },
    {
      "id": "rr-04-judging-11",
      "from": "rr-judging-judge",
      "to": "rr-judging-core",
      "label": "Malformed / failed judgment raises",
      "y": 450,
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One comparison covers the whole example set",
      "items": [
        "A provider judge sees the task, rubric, every source and both candidates\u2019 outputs. Its decision is not a collection of per-example scores."
      ]
    },
    {
      "dot": "rose",
      "title": "Rules and provider judgments stay distinct",
      "items": [
        "Rules award exact string-field matches and disqualify non-object JSON. Provider judgments may choose either winner or disqualify A, B, or both; malformed judgment fails the run."
      ]
    }
  ]
}
