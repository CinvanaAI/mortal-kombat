  "cards": [
    {
      "dot": "cyan",
      "title": "The estimate is auditable",
      "items": [
        "Amount = uncached input × input rate + cached input × cached rate + output × output rate, divided by one million."
      ]
    },
    {
      "dot": "amber",
      "title": "Unavailable means unknown",
      "items": [
        "Missing usage/rates, incompatible cache pricing or positive cache-write counts yield no amount. Zero cached input needs no cache rate. Phase/currency subtotals stay separate."
      ]
    },
    {
      "dot": "violet",
      "title": "What this does not promise",
      "items": [
        "Cost does not pick the winner. No dollar-budget enforcement, paid retry or transactional bundle write. A disk error can leave a partial folder."
      ]
    }
  ]
}
