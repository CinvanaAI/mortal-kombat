  "cards": [
    {
      "dot": "cyan",
      "title": "What configuration supplies",
      "items": [
        "Instructions; artifacts and expected fields; candidate IDs; provider/model names; rubric; judge; max_calls; dated rates."
      ]
    },
    {
      "dot": "amber",
      "title": "The preflight boundary",
      "items": [
        "CLI reserves the folder first. After preflight, run_task initializes its report and continues execution. Preflight failure can leave an empty folder."
      ]
    },
    {
      "dot": "violet",
      "title": "Two other entry paths",
      "items": [
        "example writes a new fixture task file. report validates saved-result rendering and writes a new bundle; neither runs providers."
      ]
    }
  ]
